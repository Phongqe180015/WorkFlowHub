# WorkFlowHub — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ============================================================
# DATABASE
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/workflowhub
DB_USERNAME=workflowhub
DB_PASSWORD=change_me_in_production

# ============================================================
# SERVER
# ============================================================
SERVER_PORT=8080

# ============================================================
# JWT / OAUTH2
# ============================================================
# The issuer URI of your OAuth2/JWT authorization server.
# For Spring Authorization Server (local dev): http://localhost:9000
JWT_ISSUER_URI=http://localhost:9000
JWT_SECRET_KEY=change_me_to_a_strong_random_256bit_key_in_production

# ============================================================
# REDIS (Session / Cache) — add when infrastructure module is implemented
# ============================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================================
# STORAGE (S3-compatible) — add when storage module is implemented
# ============================================================
# S3_BUCKET=workflowhub-dev
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ============================================================
# EMAIL — add when email module is implemented
# ============================================================
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@workflowhub.io
